<% layout('/layouts/boilerplate') %> <br />

<body>
  <%- include('../includes/menu.ejs')%>
  <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-2">
    <% for( let listing of listings ) { %>
    <a href="/listings/<%= listing._id %>">
      <div class="card listing-card">
        <img
          src="<%= listing.image.url%>"
          class="card-img-top"
          alt="listing image"
        />
        <div class="card-body">
          <p class="card-text">
            <b><%= listing.title %></b><br />
            &#8377;<%= listing.price.toLocaleString("en-IN")%>
            <i class="taxinfo">&nbsp;&nbsp; + 18% GST incl.</i><br />
            <!-- <%= listing.description %> <br> -->
            <%= listing.location %> &nbsp; <%=listing.country %>
          </p>
        </div>
      </div>
    </a>
    <% } %>
  </div>

  <script>
    let taxBtn = document.getElementById("flexSwitchCheckDefault");
    taxBtn.addEventListener("click", () => {
      let taxinfo = document.getElementsByClassName("taxinfo");
      for (info of taxinfo) {
        if (info.style.display != "inline") {
          info.style.display = "inline";
        } else {
          info.style.display = "none";
        }
      }
    });
  </script>
</body>
