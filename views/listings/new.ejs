<% layout('/layouts/boilerplate') %>

<body>
  <br />
  <!-- //CREATE ROUTE -->
  <h3>Create a new listing</h3>
  <br />
  <form
    method="POST"
    action="/listings"
    novalidate
    class="needs-validation"
    enctype="multipart/form-data"
  >
    <div class="row">
      <div class="col-8 offset-2">
        <div class="mb-3">
          <label for="title" class="form-label">Title</label>
          <input
            type="text"
            name="listing[title]"
            class="form-control"
            placeholder="enter title"
            required
          />
          <div class="valid-feedback">Looks good</div>
          <div class="invalid-feedback">Please add a title</div>
        </div>

        <div class="mb-3">
          <label for="description" class="form-label">Description</label>
          <textarea
            name="listing[description]"
            class="form-control"
            placeholder="enter description"
            required
          ></textarea>
          <div class="valid-feedback">Looks good</div>
          <div class="invalid-feedback">Please add a description</div>
        </div>

        <div class="mb-3">
          <label for="image" class="form-label">Upload Image </label>
          <input
            type="file"
            name="listing[image]"
            class="form-control"
          />
          <div class="valid-feedback">Looks good</div>
          <div class="invalid-feedback">Please add an image URL</div>
        </div>

        <div class="row col">
          <div class="mb-3 col-md-4">
            <label for="price" class="form-label">Price</label>
            <input
              type="number"
              required
              name="listing[price]"
              class="form-control"
              placeholder="enter price"
            />
            <div class="valid-feedback">Looks good</div>
            <div class="invalid-feedback">Enter a valid price</div>
          </div>

          <div class="mb-3 col-md-8">
            <label for="location" class="form-label">Location</label>
            <input
              type="text"
              required
              name="listing[location]"
              class="form-control"
              placeholder="enter  location"
            />
            <div class="valid-feedback">Looks good</div>
            <div class="invalid-feedback">Please add a valid location</div>
          </div>
        </div>

        <div class="mb-3">
          <label for="country" class="form-label">Country</label>
          <input
            type="text"
            required
            name="listing[country]"
            class="form-control"
            placeholder="enter  country"
          />
          <div class="valid-feedback">Looks good</div>
          <div class="invalid-feedback">Please add a valid country name</div>
        </div>
      </div>
    </div>

    <div class="row add-btn">
      <button class="btn col-1 offset-2">ADD</button>
    </div>
    <br />
  </form>
</body>
