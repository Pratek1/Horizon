# ─────────────────────────────────────────────────────────────────────────────
# Wanderlust — Environment Variables Template
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Cloudinary (https://cloudinary.com → Dashboard)
CLOUD_NAME=your_cloud_name
CLOUD_API_KEY=your_api_key
CLOUD_API_SECRET=your_api_secret

# MongoDB connection string (default for local dev; overridden in Docker)
MONGO_URL=mongodb://127.0.0.1:27017/airbnb

# Express session secret — use a long, random string in production
SESSION_SECRET=change_this_to_a_random_secret
